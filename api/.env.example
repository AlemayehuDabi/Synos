# Environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Postgres connection string used by the running app
DATABASE_URL=postgresql://synos:synos@localhost:5432/synos

# Separate database used only by the e2e test suite (never point this at DATABASE_URL)
DATABASE_URL_TEST=postgresql://synos:synos@localhost:5432/synos_test

# Random secret used by Better Auth to sign sessions/cookies. Must be 32+ characters.
# Generate one with: npx auth@latest secret
BETTER_AUTH_SECRET=replace-with-a-random-32-character-or-longer-secret

# Public base URL of this API (used by Better Auth to build absolute links, e.g. in emails)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (used for both CORS and
# Better Auth's trustedOrigins, since in this app they are always the same set)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Google OAuth (optional). Leave both blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (optional). Leave blank to disable Apple sign-in.
# APPLE_CLIENT_ID is your Services ID from the Apple Developer portal.
# APPLE_CLIENT_SECRET is a pre-generated ES256 JWT (Apple does not issue a static
# secret) - generate one from your team id / key id / .p8 private key and rotate
# it before it expires (Apple allows a maximum lifetime of ~6 months).
# APPLE_APP_BUNDLE_IDENTIFIER is only needed for native iOS sign-in.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Mail provider. Only "dev" (logs emails to the console) is implemented today.
MAIL_PROVIDER=dev
MAIL_FROM_ADDRESS=no-reply@synos.app

# Local directory where generated data-export files are written
EXPORT_STORAGE_DIR=./storage/exports

# Signal engine: max pending suggestions kept per connection per user; the
# oldest are expired to make room once this is exceeded.
MAX_PENDING_PER_CONNECTION=20

# Signal engine retention (days). Processed signals and resolved suggestions
# are pruned after their retention window; activity log entries are kept far
# longer since they are the audit trail.
SIGNAL_RETENTION_DAYS=180
SUGGESTION_RETENTION_DAYS=180
ACTIVITY_RETENTION_DAYS=730

# Signal engine: how long after an approved/auto-applied action it can still be undone.
UNDO_WINDOW_DAYS=30
