generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  settings        UserSettings?
  privacySettings PrivacySettings?
  devices         Device[]
  dataExportJobs  DataExportJob[]
  idempotencyKeys IdempotencyKey[]

  signals            Signal[]
  suggestions        Suggestion[]
  connectionSettings ConnectionSetting[]
  activityLogs       ActivityLog[]

  reviews                   Review[]
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  notificationSettings      NotificationSettings?
  notificationPushThrottles NotificationPushThrottle[]

  calendarEvents CalendarEvent[]

  tasks           Task[]
  subtasks        Subtask[]
  taskCompletions TaskCompletion[]

  habits       Habit[]
  habitEntries HabitEntry[]

  exercises       Exercise[]
  workouts        Workout[]
  programs        Program[]
  bodyMetrics     BodyMetric[]
  wearableSamples WearableSample[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Units {
  metric
  imperial
}

enum Visibility {
  private
  shared
}

enum Platform {
  ios
  android
}

enum ExportFormat {
  json
}

enum DataExportStatus {
  queued
  running
  ready
  failed
  expired
}

model UserSettings {
  id           String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone     String   @default("UTC")
  weekStartsOn Int      @default(1)
  units        Units    @default(metric)
  currency     String   @default("USD")
  locale       String   @default("en-US")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_settings")
}

model PrivacySettings {
  id        String     @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar  Visibility @default(private)
  tasks     Visibility @default(private)
  habits    Visibility @default(private)
  fitness   Visibility @default(private)
  finances  Visibility @default(private)
  meals     Visibility @default(private)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("privacy_settings")
}

model Device {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   Platform
  pushToken  String   @unique
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("devices")
}

model DataExportJob {
  id          String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      DataExportStatus @default(queued)
  format      ExportFormat     @default(json)
  storageKey  String?
  requestedAt DateTime         @default(now())
  completedAt DateTime?
  expiresAt   DateTime?
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@map("data_export_jobs")
}

model IdempotencyKey {
  id           String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String
  path         String
  statusCode   Int
  responseBody Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Signal engine
// ---------------------------------------------------------------------------

enum SignalDomain {
  calendar
  tasks
  habits
  fitness
  finances
  meals
  system
}

enum SuggestionStatus {
  pending
  approved
  dismissed
  superseded
  expired
  failed
  auto_applied
  reverted
}

enum ConnectionMode {
  off
  suggest
  auto
}

enum ResolvedBy {
  user
  system
}

enum ActivityKind {
  suggestion_created
  suggestion_edited
  suggestion_approved
  suggestion_dismissed
  auto_applied
  superseded
  expired
  reverted
  manual_override
  mode_changed
}

/// Append-only signal log. Rows are only ever updated to record processing
/// progress (processedAt/attempts/nextAttemptAt/lastError); payload/type/etc.
/// never change after creation.
model Signal {
  id            String       @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  sourceDomain  SignalDomain
  schemaVersion Int          @default(1)
  payload       Json
  subjectType   String?
  subjectId     String?
  dedupeKey     String?
  occurredAt    DateTime
  processedAt   DateTime?
  attempts      Int          @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  suggestions  Suggestion[]
  activityLogs ActivityLog[]

  @@unique([userId, dedupeKey])
  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([processedAt, nextAttemptAt])
  @@map("signals")
}

model Suggestion {
  id               String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId         String?          @db.Uuid
  signal           Signal?          @relation(fields: [signalId], references: [id], onDelete: SetNull)
  connectionId     String
  targetDomain     SignalDomain
  actionType       String
  title            String
  body             String
  params           Json
  originalParams   Json?
  targetKey        String
  dedupeKey        String
  status           SuggestionStatus @default(pending)
  failureNote      String?
  expiresAt        DateTime
  resolvedAt       DateTime?
  resolvedBy       ResolvedBy?
  supersededReason String?
  revertData       Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  activityLogs ActivityLog[]

  @@unique([userId, connectionId, dedupeKey])
  @@index([userId, status, createdAt])
  @@index([userId, targetKey, status])
  @@map("suggestions")
}

model ConnectionSetting {
  id           String         @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  mode         ConnectionMode
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, connectionId])
  @@map("connection_settings")
}

model ActivityLog {
  id           String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ActivityKind
  suggestionId String?       @db.Uuid
  suggestion   Suggestion?   @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  signalId     String?       @db.Uuid
  signal       Signal?       @relation(fields: [signalId], references: [id], onDelete: SetNull)
  connectionId String?
  targetDomain SignalDomain?
  entityRef    Json?
  before       Json?
  after        Json?
  undoneAt     DateTime?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

enum ReviewType {
  weekly
  monthly
}

/// A generated weekly/monthly review. periodStart/periodEnd are the local
/// calendar dates (in `timezone`) the review covers, both inclusive.
model Review {
  id          String     @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ReviewType
  periodStart DateTime   @db.Date
  periodEnd   DateTime   @db.Date
  timezone    String
  sections    Json
  generatedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, type, periodStart])
  @@index([userId, generatedAt])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationCategory {
  inbox_suggestion
  review_ready
  bill
  reminder
  system
}

model Notification {
  id        String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String               @db.Uuid
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  domain    SignalDomain?
  title     String
  body      String
  data      Json                 @default("{}")
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([readAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String               @db.Uuid
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  inApp     Boolean              @default(true)
  push      Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// User-level notification settings (1:1). Quiet hours are "HH:mm" in the
/// user's own timezone (UserSettings.timezone); both null means disabled.
model NotificationSettings {
  id              String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_settings")
}

/// Rate limiter state for pushes: one row per (user, category) recording when a
/// push last went out, claimed with an atomic upsert so it holds across API instances.
model NotificationPushThrottle {
  id           String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String               @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  lastPushedAt DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_push_throttles")
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

enum CalendarEventSource {
  manual
  suggestion
  auto
  sync
}

enum CalendarExceptionKind {
  cancelled
  modified
}

/// A hard event. Timed events store UTC instants plus the IANA `timezone` the
/// event lives in (recurrence is expanded in that zone, so wall-clock time is
/// kept across DST). All-day events store dates as UTC midnights: `startsAt` is
/// the first day, `endsAt` the day after the last (exclusive). `rrule` is an
/// RFC 5545 RRULE value; `seriesUntil` is the end of the last occurrence
/// (null for an open-ended series or a single event). `deletedAt` marks a tombstone.
model CalendarEvent {
  id          String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId      String              @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  location    String?
  color       String?
  allDay      Boolean             @default(false)
  startsAt    DateTime
  endsAt      DateTime
  timezone    String
  rrule       String?
  seriesUntil DateTime?
  source      CalendarEventSource @default(manual)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  exceptions CalendarEventException[]

  @@index([userId, startsAt])
  @@index([userId, seriesUntil])
  @@index([deletedAt])
  @@map("calendar_events")
}

/// One changed or removed occurrence of a recurring event, keyed by the
/// occurrence's original start (the instant, or UTC midnight of the date for
/// all-day events). The override columns only apply to `modified`; null means
/// "same as the series".
model CalendarEventException {
  id            String                @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  eventId       String                @db.Uuid
  event         CalendarEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime
  kind          CalendarExceptionKind
  title         String?
  notes         String?
  location      String?
  color         String?
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([eventId, originalStart])
  @@map("calendar_event_exceptions")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

enum TaskStatus {
  open
  completed
  skipped
}

enum TaskPriority {
  none
  low
  medium
  high
}

enum TaskSource {
  manual
  suggestion
  auto
  sync
}

enum TaskExceptionKind {
  skipped
  modified
}

enum SubtaskStatus {
  open
  completed
}

/// A task, and the master record of a recurring series when `rrule` is set (the
/// same one-row-per-series, virtually-expanded model as CalendarEvent - see
/// TaskException). `recurringGroupId` stays the same across a `scope=following`
/// split (which, like Calendar's, creates a new master row with its own `id`),
/// so a series' full history - and the adaptive-estimate rolling average, which
/// is keyed by it - survives a split; it is null for a non-recurring task, which
/// uses its own `id` for that instead. `deletedAt` marks a tombstone.
model Task {
  id               String       @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId           String       @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  notes            String?
  status           TaskStatus   @default(open)
  priority         TaskPriority @default(none)
  dueAt            DateTime?
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  timezone         String?
  estimatedMinutes Int?
  actualMinutes    Int?
  isCritical       Boolean      @default(false)
  rrule            String?
  seriesUntil      DateTime?
  recurringGroupId String?      @db.Uuid
  source           TaskSource   @default(manual)
  sortOrder        Float        @default(0)
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  exceptions  TaskException[]
  subtasks    Subtask[]
  completions TaskCompletion[]

  @@index([userId, status, dueAt])
  @@index([userId, recurringGroupId])
  @@index([userId, scheduledStart])
  @@index([deletedAt])
  @@map("tasks")
}

/// One changed or skipped occurrence of a recurring task, keyed by the
/// occurrence's original due date (mirrors CalendarEventException). The override
/// columns only apply to `modified`; null means "same as the series".
model TaskException {
  id               String            @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  taskId           String            @db.Uuid
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  originalDueAt    DateTime
  kind             TaskExceptionKind
  title            String?
  notes            String?
  priority         TaskPriority?
  dueAt            DateTime?
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  estimatedMinutes Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([taskId, originalDueAt])
  @@map("task_exceptions")
}

model Subtask {
  id        String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  taskId    String        @db.Uuid
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  status    SubtaskStatus @default(open)
  sortOrder Float         @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([taskId, sortOrder])
  @@map("subtasks")
}

/// One row per task completion (recurring or not), independent of whether the task
/// itself stays 'open' (rolled forward to its next occurrence) or becomes 'completed'.
/// Exists so period metrics (completed/missed count, estimate accuracy) have real
/// history to query even though a recurring task's own row only ever reflects its
/// current occurrence. Never updated after creation; deleted only by the task's own
/// cascade.
model TaskCompletion {
  id               String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  taskId           String    @db.Uuid
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringGroupId String?   @db.Uuid
  dueAt            DateTime?
  completedAt      DateTime  @default(now())
  estimatedMinutes Int?
  actualMinutes    Int?

  @@index([userId, completedAt])
  @@map("task_completions")
}

enum HabitType {
  build
  break
}

/// `daily`/`weekly` need no extra configuration; `specificDays` restricts to
/// `scheduleDays`; `timesPerWeek`/`timesPerMonth` require `targetPerPeriod`
/// check-ins within the period rather than specific days.
enum HabitSchedule {
  daily
  weekly
  specificDays
  timesPerWeek
  timesPerMonth
}

enum HabitSource {
  manual
  suggestion
  auto
}

enum HabitEntryStatus {
  done
  slipped
}

/// A habit to build or break. Streaks and stats (GET /habits/:id/stats) are computed
/// on read against `schedule`/`scheduleDays`/`targetPerPeriod`, never stored. `timezone`
/// is what the habit's schedule (which calendar day is "today") is evaluated in.
/// `deletedAt` marks a tombstone.
model Habit {
  id              String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  type            HabitType
  schedule        HabitSchedule
  scheduleDays    Int[]         @default([])
  targetPerPeriod Int?
  timezone        String
  color           String?
  isArchived      Boolean       @default(false)
  archivedAt      DateTime?
  source          HabitSource   @default(manual)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  entries HabitEntry[]

  @@index([userId, isArchived])
  @@index([deletedAt])
  @@map("habits")
}

/// One check-in for a habit on a given calendar date, stored as a UTC midnight instant
/// (same convention as Calendar's all-day events - see CalendarEvent). `status` is `done`
/// (completed a `build` habit) or `slipped` (broke a `break` habit, or explicitly missed a
/// `build` one - see the streak/grace rules in the Habits README section). `deletedAt`
/// marks a tombstone. The (habitId, date) uniqueness is what makes POST an upsert: at
/// most one entry per habit per date.
model HabitEntry {
  id        String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  habitId   String           @db.Uuid
  habit     Habit            @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  status    HabitEntryStatus
  note      String?
  source    HabitSource      @default(manual)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_entries")
}

enum FitnessSource {
  manual
  suggestion
  auto
  sync
}

enum ExerciseCategory {
  strength
  cardio
  flexibility
  mobility
  sports
  other
}

enum WearableSampleType {
  steps
  sleep
  heartRate
  activeEnergy
  workout
}

/// A movement a workout is built from. `userId` null is the seeded, read-only library
/// (`isCustom` false); a user's own additions carry their `userId` (`isCustom` true).
model Exercise {
  id           String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String?          @db.Uuid
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     ExerciseCategory
  muscleGroups String[]         @default([])
  isCustom     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workoutExercises WorkoutExercise[]

  @@unique([userId, name])
  @@index([userId])
  @@map("exercises")
}

/// A logged (or in-progress) workout. `completedAt` null means not completed yet.
/// `deletedAt` marks a tombstone.
model Workout {
  id              String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  workoutType     String
  startedAt       DateTime
  completedAt     DateTime?
  durationMinutes Int?
  notes           String?
  programId       String?       @db.Uuid
  program         Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  source          FitnessSource @default(manual)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  exercises          WorkoutExercise[]
  conflictingSamples WearableSample[]  @relation("SampleConflict")

  @@index([userId, startedAt])
  @@index([programId])
  @@index([deletedAt])
  @@map("workouts")
}

model WorkoutExercise {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  workoutId  String   @db.Uuid
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String   @db.Uuid
  // Deferred to commit in the migration (see there): account deletion cascades to exercises and workouts in either order.
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  sortOrder  Int      @default(0)

  sets WorkoutSet[]

  @@index([workoutId, sortOrder])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String          @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  workoutExerciseId String          @db.Uuid
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  reps              Int?
  weightKg          Float?
  durationSeconds   Int?
  distanceMeters    Float?
  rpe               Float?

  @@unique([workoutExerciseId, setNumber])
  @@map("workout_sets")
}

/// A training plan. At most one is active per user; `activatedAt` is day zero for
/// each ProgramWorkout's `dayOffset`.
model Program {
  id          String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workouts       ProgramWorkout[]
  loggedWorkouts Workout[]

  @@index([userId, isActive])
  @@map("programs")
}

/// One planned session of a Program, `dayOffset` days after the program was activated.
/// `workoutTemplate` is `{ workoutType, title?, durationMinutes?, exercises?: [{ exerciseId, sets? }] }`.
model ProgramWorkout {
  id              String  @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  programId       String  @db.Uuid
  program         Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayOffset       Int
  workoutTemplate Json

  @@index([programId, dayOffset])
  @@map("program_workouts")
}

/// A body measurement on a calendar date (stored as a UTC midnight, like HabitEntry).
model BodyMetric {
  id         String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  weightKg   Float?
  bodyFatPct Float?
  notes      String?
  source     FitnessSource @default(manual)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, date])
  @@map("body_metrics")
}

/// Raw data pushed by a wearable/health platform. Never merged into a manual Workout:
/// a `workout` sample that overlaps a manual workout but disagrees with it is kept as
/// its own row with `conflict` set and `conflictWorkoutId` pointing at that workout.
model WearableSample {
  id                String             @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId            String             @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              WearableSampleType
  startsAt          DateTime
  endsAt            DateTime
  value             Json
  sourceDevice      String
  dedupeKey         String
  conflict          Boolean            @default(false)
  conflictWorkoutId String?            @db.Uuid
  conflictWorkout   Workout?           @relation("SampleConflict", fields: [conflictWorkoutId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, type, startsAt])
  @@index([conflictWorkoutId])
  @@map("wearable_samples")
}
