generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  settings        UserSettings?
  privacySettings PrivacySettings?
  devices         Device[]
  dataExportJobs  DataExportJob[]
  idempotencyKeys IdempotencyKey[]

  signals            Signal[]
  suggestions        Suggestion[]
  connectionSettings ConnectionSetting[]
  activityLogs       ActivityLog[]

  reviews                   Review[]
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  notificationSettings      NotificationSettings?
  notificationPushThrottles NotificationPushThrottle[]

  calendarEvents CalendarEvent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Units {
  metric
  imperial
}

enum Visibility {
  private
  shared
}

enum Platform {
  ios
  android
}

enum ExportFormat {
  json
}

enum DataExportStatus {
  queued
  running
  ready
  failed
  expired
}

model UserSettings {
  id           String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone     String   @default("UTC")
  weekStartsOn Int      @default(1)
  units        Units    @default(metric)
  currency     String   @default("USD")
  locale       String   @default("en-US")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_settings")
}

model PrivacySettings {
  id        String     @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar  Visibility @default(private)
  tasks     Visibility @default(private)
  habits    Visibility @default(private)
  fitness   Visibility @default(private)
  finances  Visibility @default(private)
  meals     Visibility @default(private)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("privacy_settings")
}

model Device {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   Platform
  pushToken  String   @unique
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("devices")
}

model DataExportJob {
  id          String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      DataExportStatus @default(queued)
  format      ExportFormat     @default(json)
  storageKey  String?
  requestedAt DateTime         @default(now())
  completedAt DateTime?
  expiresAt   DateTime?
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@map("data_export_jobs")
}

model IdempotencyKey {
  id           String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String
  path         String
  statusCode   Int
  responseBody Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Signal engine
// ---------------------------------------------------------------------------

enum SignalDomain {
  calendar
  tasks
  habits
  fitness
  finances
  meals
  system
}

enum SuggestionStatus {
  pending
  approved
  dismissed
  superseded
  expired
  failed
  auto_applied
  reverted
}

enum ConnectionMode {
  off
  suggest
  auto
}

enum ResolvedBy {
  user
  system
}

enum ActivityKind {
  suggestion_created
  suggestion_edited
  suggestion_approved
  suggestion_dismissed
  auto_applied
  superseded
  expired
  reverted
  manual_override
  mode_changed
}

/// Append-only signal log. Rows are only ever updated to record processing
/// progress (processedAt/attempts/nextAttemptAt/lastError); payload/type/etc.
/// never change after creation.
model Signal {
  id            String       @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  sourceDomain  SignalDomain
  schemaVersion Int          @default(1)
  payload       Json
  subjectType   String?
  subjectId     String?
  dedupeKey     String?
  occurredAt    DateTime
  processedAt   DateTime?
  attempts      Int          @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  suggestions  Suggestion[]
  activityLogs ActivityLog[]

  @@unique([userId, dedupeKey])
  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([processedAt, nextAttemptAt])
  @@map("signals")
}

model Suggestion {
  id               String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId         String?          @db.Uuid
  signal           Signal?          @relation(fields: [signalId], references: [id], onDelete: SetNull)
  connectionId     String
  targetDomain     SignalDomain
  actionType       String
  title            String
  body             String
  params           Json
  originalParams   Json?
  targetKey        String
  dedupeKey        String
  status           SuggestionStatus @default(pending)
  failureNote      String?
  expiresAt        DateTime
  resolvedAt       DateTime?
  resolvedBy       ResolvedBy?
  supersededReason String?
  revertData       Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  activityLogs ActivityLog[]

  @@unique([userId, connectionId, dedupeKey])
  @@index([userId, status, createdAt])
  @@index([userId, targetKey, status])
  @@map("suggestions")
}

model ConnectionSetting {
  id           String         @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  mode         ConnectionMode
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, connectionId])
  @@map("connection_settings")
}

model ActivityLog {
  id           String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ActivityKind
  suggestionId String?       @db.Uuid
  suggestion   Suggestion?   @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  signalId     String?       @db.Uuid
  signal       Signal?       @relation(fields: [signalId], references: [id], onDelete: SetNull)
  connectionId String?
  targetDomain SignalDomain?
  entityRef    Json?
  before       Json?
  after        Json?
  undoneAt     DateTime?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

enum ReviewType {
  weekly
  monthly
}

/// A generated weekly/monthly review. periodStart/periodEnd are the local
/// calendar dates (in `timezone`) the review covers, both inclusive.
model Review {
  id          String     @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ReviewType
  periodStart DateTime   @db.Date
  periodEnd   DateTime   @db.Date
  timezone    String
  sections    Json
  generatedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, type, periodStart])
  @@index([userId, generatedAt])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationCategory {
  inbox_suggestion
  review_ready
  bill
  reminder
  system
}

model Notification {
  id        String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String               @db.Uuid
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  domain    SignalDomain?
  title     String
  body      String
  data      Json                 @default("{}")
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([readAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String               @db.Uuid
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  inApp     Boolean              @default(true)
  push      Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// User-level notification settings (1:1). Quiet hours are "HH:mm" in the
/// user's own timezone (UserSettings.timezone); both null means disabled.
model NotificationSettings {
  id              String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("notification_settings")
}

/// Rate limiter state for pushes: one row per (user, category) recording when a
/// push last went out, claimed with an atomic upsert so it holds across API instances.
model NotificationPushThrottle {
  id           String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId       String               @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  lastPushedAt DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_push_throttles")
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

enum CalendarEventSource {
  manual
  suggestion
  auto
  sync
}

enum CalendarExceptionKind {
  cancelled
  modified
}

/// A hard event. Timed events store UTC instants plus the IANA `timezone` the
/// event lives in (recurrence is expanded in that zone, so wall-clock time is
/// kept across DST). All-day events store dates as UTC midnights: `startsAt` is
/// the first day, `endsAt` the day after the last (exclusive). `rrule` is an
/// RFC 5545 RRULE value; `seriesUntil` is the end of the last occurrence
/// (null for an open-ended series or a single event). `deletedAt` marks a tombstone.
model CalendarEvent {
  id          String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId      String              @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  location    String?
  color       String?
  allDay      Boolean             @default(false)
  startsAt    DateTime
  endsAt      DateTime
  timezone    String
  rrule       String?
  seriesUntil DateTime?
  source      CalendarEventSource @default(manual)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  exceptions CalendarEventException[]

  @@index([userId, startsAt])
  @@index([userId, seriesUntil])
  @@index([deletedAt])
  @@map("calendar_events")
}

/// One changed or removed occurrence of a recurring event, keyed by the
/// occurrence's original start (the instant, or UTC midnight of the date for
/// all-day events). The override columns only apply to `modified`; null means
/// "same as the series".
model CalendarEventException {
  id            String                @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  eventId       String                @db.Uuid
  event         CalendarEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime
  kind          CalendarExceptionKind
  title         String?
  notes         String?
  location      String?
  color         String?
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([eventId, originalStart])
  @@map("calendar_event_exceptions")
}
